// North Pole Direct Line data model.
// Data minimization: no audio and no transcripts are ever stored. Child details
// live only in Child / TalkingPoint / Memory rows that parents control and can delete.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationLength {
  SHORT
  MEDIUM
  LONG
}

enum Priority {
  HIGH
  NORMAL
  LOW
}

enum MemoryStatus {
  PROPOSED
  APPROVED
}

enum MemorySource {
  CALL
  PARENT
}

enum CallStatus {
  CONNECTING
  ACTIVE
  COMPLETED
  FAILED
  LIMIT_REACHED
  DISCONNECTED
  ENDED_BY_PARENT
}

enum WishSource {
  PARENT
  CALL
}

enum ParentRole {
  OWNER
  PARENT
}

enum SummaryStatus {
  NONE
  PROPOSED
  APPROVED
}

model Family {
  id        String   @id @default(cuid())
  name      String   @default("Our Family")
  timezone  String   @default("America/New_York")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Family-wide safety controls (owner-managed)
  callingEnabled          Boolean @default(true)
  maxCallMinutes          Int     @default(10)
  dailyMinutesPerChild    Int     @default(20)
  weeklyMinutesPerChild   Int     @default(20) // resets Monday, family time zone
  generateMemoryProposals Boolean @default(true)
  autoRecallCalls         Boolean @default(true) // Santa gets recaps of recent calls without approval
  ambientSound            Boolean @default(false)
  elevenAgentId           String? // ElevenLabs agent created by the app
  elevenAgentVersion      Int     @default(0) // agent settings version last pushed to ElevenLabs

  // Contact photo (stored in the database so it works on serverless hosts)
  santaPhoto          Bytes?
  santaPhotoType      String?
  santaPhotoUpdatedAt DateTime?

  personality SantaPersonality?
  parents     ParentUser[]
  children    Child[]
  devices     FamilyDevice[]
}

model SantaPersonality {
  id                   String             @id @default(cuid())
  familyId             String             @unique
  family               Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  voice                String             @default("ash")
  customVoiceId        String?
  humor                Int                @default(3) // 1-5
  energy               Int                @default(3) // 1-5
  northPoleReferences  Int                @default(3) // 1-5
  conversationLength   ConversationLength @default(MEDIUM)
  speakingPace         Float              @default(0.9) // realtime audio.output.speed; slower reads older
  elevenVoiceId        String? // ElevenLabs voice; falls back to ELEVENLABS_VOICE_ID
  elevenLlm            String             @default("gemini-2.5-flash")
  topicsToAvoid        String             @default("")
  nextCallInstructions String             @default("")
  updatedAt            DateTime           @updatedAt
}

model ParentUser {
  id                 String          @id @default(cuid())
  familyId           String
  family             Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email              String          @unique
  name               String
  passwordHash       String
  role               ParentRole      @default(PARENT)
  mustChangePassword Boolean         @default(false)
  // Each parent has their own device code; a paired device shows only their children.
  accessCodeHash     String?
  accessVersion      Int             @default(1)
  consentAt          DateTime?
  createdAt          DateTime        @default(now())
  lastLoginAt        DateTime?
  sessions           ParentSession[]
  children           ChildAccess[]
  devices            FamilyDevice[]
}

/// Which parents manage which children. A child can have several parents.
model ChildAccess {
  parentUserId String
  parentUser   ParentUser @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  childId      String
  child        Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([parentUserId, childId])
  @@index([childId])
}

model ParentSession {
  id         String     @id // sha256 of the opaque cookie token
  userId     String
  user       ParentUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime   @default(now())

  @@index([userId])
}

model FamilyDevice {
  id            String     @id @default(cuid())
  familyId      String
  family        Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  parentUserId  String
  parentUser    ParentUser @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  tokenHash     String     @unique
  label         String     @default("Family device")
  accessVersion Int
  createdAt     DateTime   @default(now())
  lastSeenAt    DateTime   @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  calls         Call[]

  @@index([familyId])
  @@index([parentUserId])
}

model Child {
  id                   String   @id @default(cuid())
  familyId             String
  family               Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  firstName            String
  nickname             String   @default("")
  age                  Int?
  birthday             String   @default("") // free text, e.g. "March 4"
  parents              String   @default("")
  siblings             String   @default("")
  pets                 String   @default("")
  school               String   @default("")
  sportsAndTeams       String   @default("")
  hobbies              String   @default("")
  favoriteActivities   String   @default("")
  accomplishments      String   @default("")
  challengesAndGoals   String   @default("")
  christmasWishes      String   @default("")
  traditions           String   @default("")
  otherDetails         String   @default("")
  customFields         Json     @default("[]") // [{ label, value }]
  topicsToAvoid        String   @default("")
  nextCallInstructions String   @default("")
  callingEnabled       Boolean  @default(true)
  /// When the owner last reset this child's time limits. Calls before this don't count toward today's or this week's limit.
  limitsResetAt        DateTime?
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  talkingPoints TalkingPoint[]
  memories      Memory[]
  calls         Call[]
  access        ChildAccess[]
  wishes        WishListItem[]

  @@index([familyId])
}

model TalkingPoint {
  id              String    @id @default(cuid())
  childId         String
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  topic           String
  details         String
  priority        Priority  @default(NORMAL)
  expiresAt       DateTime?
  enabled         Boolean   @default(true)
  lastDiscussedAt DateTime?
  timesDiscussed  Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([childId])
}

model Memory {
  id               String       @id @default(cuid())
  childId          String
  child            Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  content          String
  status           MemoryStatus @default(PROPOSED)
  source           MemorySource @default(CALL)
  callId           String?
  call             Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  reviewedAt       DateTime?
  lastReferencedAt DateTime?

  @@index([childId, status])
}

/// A Christmas wish. Links, notes and "purchased" are for parents only; Santa
/// sees just the title and details of approved items he's allowed to mention.
model WishListItem {
  id              String     @id @default(cuid())
  childId         String
  child           Child      @relation(fields: [childId], references: [id], onDelete: Cascade)
  title           String
  details         String     @default("") // size, color, model: shared with Santa
  link            String? // parent-only
  notes           String     @default("") // parent-only (price, where to buy, who's getting it)
  topWish         Boolean    @default(false)
  purchased       Boolean    @default(false) // parent-only
  santaCanMention Boolean    @default(true)
  approved        Boolean    @default(true) // wishes heard on calls wait for a parent
  source          WishSource @default(PARENT)
  callId          String?
  call            Call?      @relation(fields: [callId], references: [id], onDelete: SetNull)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([childId])
}

model Call {
  id              String         @id @default(cuid())
  childId         String
  child           Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId        String?
  device          FamilyDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  resumedFromId   String?
  status          CallStatus     @default(CONNECTING)
  endReason       String?
  openaiCallId    String?
  model           String?
  voice           String?
  maxSeconds      Int
  startedAt       DateTime       @default(now())
  connectedAt     DateTime?
  endedAt         DateTime?
  lastHeartbeatAt DateTime?
  durationSec     Int            @default(0)
  summary         String?
  summaryStatus   SummaryStatus  @default(NONE)
  safetyFlag      Boolean        @default(false)
  safetyNote      String?
  memories        Memory[]
  wishes          WishListItem[]

  @@index([childId, startedAt])
  @@index([status])
}

model RateLimitBucket {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}
