# ─────────────────────────────────────────────────────────────
# North Pole Direct Line · environment variables
# Copy to .env for local development. In production, set these in
# your host's dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.
# ─────────────────────────────────────────────────────────────

# REQUIRED · PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, local…)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"

# REQUIRED · OpenAI API key (server-side only; never sent to the browser)
OPENAI_API_KEY=""

# REQUIRED (first run) · one-time token you type on /parent/setup to create the first
# parent account. Use a long random value, e.g. `openssl rand -base64 32`.
SETUP_TOKEN=""

# RECOMMENDED · protects /api/cron/sweep (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=""

# OPTIONAL · model overrides (defaults shown). Change only if your account lacks access.
# OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
# OPENAI_TRANSCRIPTION_MODEL="gpt-transcribe"
# OPENAI_SUMMARY_MODEL="gpt-6-luna"

# TESTING ONLY · point the server at a mock OpenAI API
# OPENAI_BASE_URL="http://localhost:4010/v1"
